; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Tangtang Survivors"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

; 오디오는 씬을 갈아 끼워도(재시작) 끊기면 안 되므로 autoload 다.
; process_mode 는 audio_manager.gd 가 ALWAYS 로 올린다 — 일시정지 중에도
; 배경음악이 흐르고 레벨업 효과음이 나야 한다.
Audio="*res://scripts/audio_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="landscape"

[audio]

; 기본 경로와 같지만 일부러 적어 둔다. 파일이 사라지면 조용히 Master 하나짜리
; 레이아웃으로 되돌아가는데, 그러면 음악/효과음 음량 조절이 통째로 죽는다.
buses/default_bus_layout="res://default_bus_layout.tres"

[input]

move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":0,"physical_keycode":65)
]
}
move_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":0,"physical_keycode":68)
]
}
move_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":0,"physical_keycode":87)
]
}
move_down={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":0,"physical_keycode":83)
]
}

[rendering]

renderer/rendering_method="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[input_devices]

; 마우스 드래그를 터치로 바꾼다. PC와 웹에서도 조이스틱을 그대로 시험할 수 있고,
; 폰에만 있는 기능을 폰 없이 검증할 수 있다.
pointing/emulate_touch_from_mouse=true
