script = ExtResource("1_enemy")

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
shape = SubResource("CircleShape2D_enemy")

[node name="Sprite" type="Sprite2D" parent="."]
; 텍스처는 256px, 기본 표시 크기는 60px 이므로 60/256 = 0.234375.
; 변종별 크기는 enemy 노드의 scale(WaveData 의 "scale")이 곱한다.
scale = Vector2(0.234375, 0.234375)
texture = ExtResource("2_enemy_basic")

[node name="Flash" type="Sprite2D" parent="."]
; 피격 번쩍임용 흰색 오버레이.
;
; 예전에는 Polygon2D 의 color 를 흰색으로 바꿨다가 되돌렸다. 텍스처 스프라이트에는
; 그 수법을 쓸 수 없다 — modulate 는 곱셈이라 색을 **밝게** 만들 수 없기 때문이다.
; 같은 텍스처를 흰색으로 칠해 위에 겹치고 알파만 조절하는 편이 확실하다.
scale = Vector2(0.234375, 0.234375)
modulate = Color(1, 1, 1, 1)
self_modulate = Color(1, 1, 1, 0)
texture = ExtResource("2_enemy_basic")
