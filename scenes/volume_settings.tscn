[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_bar_background"]
; **불투명이어야 한다.** Godot 기본 ProgressBar 스타일은 반투명이라, 화면 한가운데에
; 고정된 주인공이 바 한복판으로 그대로 비쳐 보였다. 캡처로 발견했고 M17 레벨업 카드와
; M18 일시정지 버튼에서 이미 두 번 겪은 것과 같은 함정이다.
bg_color = Color(0.09, 0.1, 0.13, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.35, 0.39, 0.47, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_bar_fill"]
; 찬 부분은 메뉴의 강조색(노랑)이다. 회색 위 회색이면 100%인지 0%인지 구별되지 않는다.
bg_color = Color(1, 0.83, 0.29, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

