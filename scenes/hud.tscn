[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/hud.gd" id="1_hud"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_bar_background"]
; 화면 가로 전체를 지르는 막대라 예전 색(0.2,0.2,0.24)으로는 **빈 바가 꽉 찬 것처럼**
; 보였다. 배경을 어둡게 내려서 파란 채움이 어디까지 왔는지가 한눈에 읽히게 한다.
bg_color = Color(0.11, 0.11, 0.14, 0.92)
border_width_top = 2
border_width_bottom = 2
border_color = Color(0, 0, 0, 0.8)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_level_tab"]
bg_color = Color(0.11, 0.11, 0.14, 0.92)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0, 0, 0, 0.8)
content_margin_left = 10.0
content_margin_right = 10.0

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_experience_fill"]
bg_color = Color(0.35, 0.6, 1, 1)

[node name="HUD" type="CanvasLayer"]
; 3 = PROCESS_MODE_ALWAYS (2는 WHEN_PAUSED라 평소에 멈춘다)
process_mode = 3
script = ExtResource("1_hud")

[node name="DangerVignette" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 0.0
offset_top = 0.0
offset_right = 0.0
offset_bottom = 0.0
mouse_filter = 2
color = Color(0.8, 0.05, 0.08, 1)
modulate = Color(1, 1, 1, 0)

; 체력바는 주인공 발밑으로 옮겼다. HUD에도 두면 같은 정보를 중복 표시하게 된다.
;
; 경험치 바는 **화면 맨 위에 붙인다.** 아래(122)에 있을 때는 화면 가로를 지르는
; 불투명한 띠가 놀이 영역 한복판을 가로질렀고, 적이 그 뒤로 지나가는 것이 어색했다.
; HUD 는 CanvasLayer 라 무엇을 해도 항상 세계보다 위에 그려지므로, 겹침을 줄이는
; 방법은 **띠를 화면 가장자리로 밀어내는 것**뿐이다.
[node name="ExperienceBar" type="ProgressBar" parent="."]
layout_mode = 1
anchor_right = 1.0
offset_left = 110.0
offset_top = 6.0
offset_right = -12.0
offset_bottom = 28.0
show_percentage = false
mouse_filter = 2
theme_override_styles/background = SubResource("StyleBoxFlat_bar_background")
theme_override_styles/fill = SubResource("StyleBoxFlat_experience_fill")

[node name="LevelLabel" type="Label" parent="."]
; 경험치 바 왼쪽 끝에 붙는 탭. 레퍼런스의 `LV.3` 자리다.
layout_mode = 1
offset_left = 12.0
offset_top = 6.0
offset_right = 104.0
offset_bottom = 28.0
theme_override_styles/normal = SubResource("StyleBoxFlat_level_tab")
theme_override_colors/font_color = Color(1, 0.83, 0.29, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 6
theme_override_font_sizes/font_size = 20
text = "Lv.0"
horizontal_alignment = 1
vertical_alignment = 1
mouse_filter = 2

[node name="TimeLabel" type="Label" parent="."]
layout_mode = 1
; 밝은 적과 젬 위에서도 숫자가 배경에 녹지 않도록 굵은 검은 외곽선을 둔다.
anchor_left = 0.5
anchor_right = 0.5
offset_left = -180.0
offset_top = 34.0
offset_right = 180.0
offset_bottom = 98.0
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 10
theme_override_font_sizes/font_size = 48
text = "0:00"
horizontal_alignment = 1
vertical_alignment = 1
mouse_filter = 2

[node name="KillLabel" type="Label" parent="."]
layout_mode = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -220.0
offset_top = 42.0
offset_right = -20.0
offset_bottom = 76.0
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 6
theme_override_font_sizes/font_size = 26
text = "처치 0"
horizontal_alignment = 2
vertical_alignment = 1
mouse_filter = 2
