[node name="ScreenShake" type="Node" parent="."]
; 흔드는 대상은 **카메라**다. Main 을 흔들면 카메라도 그 자식으로 함께 움직여
; 화면에는 아무 변화도 나타나지 않는다 (M16 이전에는 카메라가 없어 Main 을 흔드는
; 것이 곧 화면을 흔드는 것이었다).
script = ExtResource("15_screen_shake")
target_path = NodePath("../Player/Camera2D")

[node name="GameFlow" parent="." instance=ExtResource("12_game_flow")]
