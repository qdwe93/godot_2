[node name="Main" type="Node2D"]
script = ExtResource("1_main")

[node name="BackgroundLayer" type="CanvasLayer" parent="."]
; 배경을 CanvasLayer 안에 둔다. 이유가 두 가지다.
;
; 1. Control 의 앵커는 부모가 Node2D 면 동작하지 않는다 (부모 영역이 0x0 으로 잡힌다).
;    CanvasLayer 아래에서는 뷰포트 전체를 기준으로 앵커가 제대로 걸린다.
; 2. CanvasLayer 안에 있으면 카메라와 흔들림의 영향을 받지 않는다. 화면 좌표에
;    붙박여 있으므로 어떤 경우에도 가장자리가 드러나지 않는다 (M9 에서는 상하좌우
;    40px 를 덧대야 했다).
;
; M16 이후 이 ColorRect 는 **바탕색**만 담당하고, 움직임을 보여주는 격자는 월드
; 좌표계의 Ground 노드가 그린다.
layer = -1

[node name="Background" type="ColorRect" parent="BackgroundLayer"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
; 실제 기준값은 BackgroundGrid.read_tile_mean_colour()가 실행 중에 구하며 이 값은 편집기 미리보기용이다.
color = Color(0.663, 0.639, 0.769, 1)
mouse_filter = 2

[node name="Ground" type="Sprite2D" parent="."]
; 흐르는 바닥 격자. 카메라가 들어온 뒤로 **움직이고 있다는 것을 보여주는 유일한
; 단서**다. 단색 배경만 있으면 주인공이 화면 중앙에 고정된 채 아무것도 흐르지 않아
; 서 있는 것과 달리는 것이 구분되지 않는다.
;
; ColorRect 배경(BackgroundLayer, layer=-1)보다는 위, 나머지 전부보다는 아래에
; 그린다 (z_index = -100, 스크립트에서 설정).
script = ExtResource("17_background_grid")
texture = ExtResource("18_ground_tile")
texture_repeat = 2
region_enabled = true
region_rect = Rect2(-4096, -4096, 8192, 8192)

[node name="EnemyContainer" type="Node2D" parent="."]
; 그리는 순서를 z_index 로 못박는다. 예전에는 전부 0 이라 **씬 트리 순서**가 곧
; 그리는 순서였고, 그래서 젬(PickupContainer)이 적보다 나중에 나온다는 이유만으로
; 적 위에 그려졌다 — 몹이 경험치 구슬 뒤로 지나가는 것처럼 보였다.
;
; 바닥(-100) < 젬(-10) < 적(0) < 주인공(10) < 투사체(20) < 이펙트(30)
z_index = 0

[node name="ProjectileContainer" type="Node2D" parent="." groups=["projectile_container"]]
z_index = 20

[node name="PickupContainer" type="Node2D" parent="."]
z_index = -10

