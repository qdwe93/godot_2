[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/level_up_ui.gd" id="1_level_up_ui"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_card"]
; 카드는 **불투명**해야 한다. 버튼 기본 스타일은 반투명이라 카드 한가운데로
; 뒤의 게임 화면(화면 중앙에 고정된 주인공)이 그대로 비쳐 보였다.
; 이 색은 docs/asset_gen 의 아이콘 프롬프트에 적어 둔 카드 배경색(#2E3440)과 같다.
bg_color = Color(0.18, 0.2, 0.25, 1)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(0.35, 0.39, 0.47, 1)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_card_hover"]
bg_color = Color(0.24, 0.27, 0.33, 1)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(1, 0.83, 0.29, 1)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_card_pressed"]
bg_color = Color(0.3, 0.34, 0.42, 1)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(1, 0.83, 0.29, 1)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12

[node name="LevelUpUI" type="CanvasLayer"]
; layer 를 명시한다. CanvasLayer 끼리 layer 가 같으면 그리는 순서가 **씬 트리 순서**로
; 정해지는데, main.tscn 에서 LevelUpUI 가 HUD 보다 먼저 나와서 HUD 가 위에 그려졌다.
; 그 결과 상단 한가운데로 커진 시계가 "스킬 선택" 제목을 정확히 덮었다.
;
; 0 = HUD, 2 = 터치 조이스틱, 5 = 여기, 10 = GameFlow(타이틀/게임오버/일시정지).
; 레벨업 화면은 HUD 와 조이스틱을 덮고, 타이틀·게임오버에는 덮인다.
layer = 5
script = ExtResource("1_level_up_ui")
process_mode = 3
visible = false

[node name="Dimmer" type="ColorRect" parent="."]
; 앵커로 뷰포트 전체를 덮는다. offset 으로 1280x720 을 고정하면 화면비가 다른
; 기기(S21 은 1600x720)에서 오른쪽이 안 덮이고 게임이 그대로 비친다.
; 앵커가 먹으려면 layout_mode = 1 이 필요하다 — anchors_preset 은 에디터용 힌트다.
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
; **완전 불투명이다.** 반투명이었을 때(0.78) 뒤의 HUD 가 그대로 비쳤고, 특히 상단
; 한가운데로 커진 시계가 "스킬 선택" 제목 자리에 정확히 겹쳐 유령처럼 남았다.
; 0.985 까지 올려도 큰 흰 글자에 굵은 외곽선이라 여전히 읽혔다.
;
; 둘을 떼어 놓을 자리가 없다 — 카드 3장이 이미 세로를 다 쓴다. 레퍼런스의 레벨업
; 화면도 게임을 비추지 않고 통째로 덮으므로 그쪽에 맞춘다.
color = Color(0.05, 0.06, 0.09, 1)
mouse_filter = 0

[node name="Title" type="Label" parent="."]
; 가로 전체를 차지하게 두고 가운데 정렬한다. 뷰포트 폭이 얼마든 항상 한가운데다.
layout_mode = 1
anchor_right = 1.0
offset_top = 22.0
offset_bottom = 86.0
theme_override_font_sizes/font_size = 44
theme_override_colors/font_color = Color(1, 0.83, 0.29, 1)
text = "스킬 선택"
horizontal_alignment = 1
vertical_alignment = 1
mouse_filter = 2

[node name="Slots" type="HBoxContainer" parent="."]
; 보유 스킬 슬롯 바. 칸은 코드에서 UpgradeData 의 정의 순서대로 만든다 —
; 여기에 칸을 하드코딩하면 업그레이드를 추가해도 슬롯이 안 늘어나는데 에러는 안 난다.
layout_mode = 1
anchor_left = 0.5
anchor_right = 0.5
offset_left = -400.0
offset_top = 96.0
offset_right = 400.0
offset_bottom = 152.0
alignment = 1
theme_override_constants/separation = 36
mouse_filter = 2

[node name="WeaponRow" type="HBoxContainer" parent="Slots"]
layout_mode = 2
theme_override_constants/separation = 8
mouse_filter = 2

[node name="PassiveRow" type="HBoxContainer" parent="Slots"]
layout_mode = 2
theme_override_constants/separation = 8
mouse_filter = 2

[node name="Choices" type="HBoxContainer" parent="."]
; 카드 3장을 가로로 나란히. 세로 화면 레퍼런스와 달리 우리는 가로라
; 카드를 옆으로 늘어놓는 편이 오히려 자연스럽다.
layout_mode = 1
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -585.0
offset_top = -190.0
offset_right = 585.0
offset_bottom = 270.0
alignment = 1
theme_override_constants/separation = 30

[node name="Choice0" type="Button" parent="Choices"]
; 카드 전체가 표적이다. 안의 라벨·아이콘은 mouse_filter = 2 로 클릭을 흘려보낸다.
custom_minimum_size = Vector2(370, 460)
layout_mode = 2
theme_override_styles/normal = SubResource("StyleBoxFlat_card")
theme_override_styles/hover = SubResource("StyleBoxFlat_card_hover")
theme_override_styles/pressed = SubResource("StyleBoxFlat_card_pressed")
theme_override_styles/focus = SubResource("StyleBoxFlat_card_hover")

